{
  "info": {
    "name": "PPDB SLB - API (Kelompok 5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cookie sesi admin diisi manual di Postman (header Cookie). Jangan disimpan di file ini. Sudah diverifikasi terhadap endpoint live."
  },
  "variable": [
    {
      "key": "base",
      "value": "https://ppdb-slbsanadharma.up.railway.app/ppdb-slb"
    },
    {
      "key": "id_b",
      "value": "ISI_ID_AKUN_UJI_B"
    },
    {
      "key": "id_c",
      "value": "ISI_ID_AKUN_UJI_C"
    },
    {
      "key": "id_d",
      "value": "ISI_ID_AKUN_UJI_D"
    }
  ],
  "item": [
    {
      "name": "TC-AP-01 verifikasi dokumen valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 & JSON sukses', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "  const j = pm.response.json();",
              "  pm.expect(j.success).to.eql(true);",
              "  pm.expect(j).to.have.all.keys('success', 'message', 'file_field', 'doc_status', 'status_berkas', 'status_verifikasi', 'data_lengkap', 'kekurangan');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "url": {
          "raw": "{{base}}/admin/detail-pendaftar.php?id={{id_b}}",
          "host": [
            "{{base}}"
          ],
          "path": [
            "admin",
            "detail-pendaftar.php"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{id_b}}"
            }
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "ajax_verifikasi_dokumen",
              "value": "1"
            },
            {
              "key": "file_field",
              "value": "foto_siswa"
            },
            {
              "key": "status",
              "value": "verified"
            }
          ]
        }
      }
    },
