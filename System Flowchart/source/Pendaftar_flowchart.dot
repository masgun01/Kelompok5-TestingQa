digraph F {
  graph [rankdir=TB, splines=spline, nodesep=0.7, ranksep=0.45, fontname="Helvetica", label="FLOWCHART ROLE PENDAFTAR", labelloc=t, labeljust=l, fontsize=16, pad=0.4, bgcolor="white"];
  node [fontname="Helvetica", fontsize=12, penwidth=1.3];
  edge [fontname="Helvetica", fontsize=11, color="#222222", arrowsize=0.8];
  s [shape=ellipse, style=filled, fillcolor="#d5e8d4", color="#82b366", width=1.6, height=0.6, label="Mulai"];
  p0 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Login"];
  p1 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Melihat Beranda\n(progress & status)"];
  f0 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Pilih jenjang\n(TKLB / SDLB / SMPLB)"];
  d0 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Jenjang dipilih?"];
  f1 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Isi data pribadi"];
  d1 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Field wajib\nterisi?"];
  f2 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Pilih surat keterangan"];
  f3 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Isi data orang tua / wali"];
  u1 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Upload berkas"];
  du [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Format JPG/JPEG/PNG/PDF\n& ukuran ≤ 2 MB?"];
  u2 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Berkas tersimpan,\nmenunggu verifikasi admin"];
  g1 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Melihat Pengumuman"];
  dg [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Hasil seleksi?"];
  g2 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Tampil pesan\ntidak lolos"];
  r1 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Daftar Ulang: lihat berkas\n& informasi pembayaran"];
  lo [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Logout"];
  e [shape=ellipse, style=filled, fillcolor="#d5e8d4", color="#82b366", width=1.6, height=0.6, label="Selesai"];
  s -> p0 [];
  p0 -> p1 [];
  p1 -> f0 [];
  f0 -> d0 [];
  d0 -> f0 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  d0 -> f1 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  f1 -> d1 [];
  d1 -> f1 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  d1 -> f2 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  f2 -> f3 [];
  f3 -> u1 [];
  u1 -> du [];
  du -> u1 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  du -> u2 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  u2 -> g1 [];
  g1 -> dg [];
  dg -> g1 [label="Pending", fontcolor="#333333", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  dg -> g2 [label="Gagal", fontcolor="#333333", fontname="Helvetica-Bold"];
  dg -> r1 [label="Lolos", fontcolor="#333333", fontname="Helvetica-Bold"];
  g2 -> lo [];
  r1 -> lo [];
  lo -> e [];
}