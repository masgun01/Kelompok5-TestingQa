digraph F {
  graph [rankdir=TB, splines=spline, nodesep=0.7, ranksep=0.45, fontname="Helvetica", label="FLOWCHART ROLE ADMIN", labelloc=t, labeljust=l, fontsize=16, pad=0.4, bgcolor="white"];
  node [fontname="Helvetica", fontsize=12, penwidth=1.3];
  edge [fontname="Helvetica", fontsize=11, color="#222222", arrowsize=0.8];
  s [shape=ellipse, style=filled, fillcolor="#d5e8d4", color="#82b366", width=1.6, height=0.6, label="Mulai"];
  a0 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Login"];
  a1 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Melihat Dashboard\n(statistik pendaftar)"];
  a2 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Buka menu Verifikasi"];
  a3 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Cari / saring pendaftar"];
  a4 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Buka detail pendaftar"];
  a5 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Verifikasi tiap berkas\n(valid / tolak)"];
  d1 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Data & berkas\nlayak diterima?"];
  t1 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Isi catatan penolakan"];
  t2 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Klik Tolak: status ditolak,\nemail dikirim"];
  a6 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Klik Terima"];
  d2 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Semua berkas wajib\nterverifikasi?"];
  a7 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Status diterima,\nemail konfirmasi dikirim"];
  a8 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Buka menu Kelola Pengumuman"];
  a9 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Pilih hasil seleksi\n& isi catatan"];
  d3 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Hasil seleksi?"];
  h1 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Simpan & kirim email\nhasil seleksi"];
  h2 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Simpan tanpa email"];
  lo [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Logout"];
  e [shape=ellipse, style=filled, fillcolor="#d5e8d4", color="#82b366", width=1.6, height=0.6, label="Selesai"];
  s -> a0 [];
  a0 -> a1 [];
  a1 -> a2 [];
  a2 -> a3 [];
  a3 -> a4 [];
  a4 -> a5 [];
  a5 -> d1 [];
  d1 -> t1 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold"];
  t1 -> t2 [];
  t2 -> lo [];
  d1 -> a6 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  a6 -> d2 [];
  d2 -> a5 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  d2 -> a7 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  a7 -> a8 [];
  a8 -> a9 [];
  a9 -> d3 [];
  d3 -> h1 [label="Lolos / Gagal", fontcolor="#333333", fontname="Helvetica-Bold"];
  d3 -> h2 [label="Pending", fontcolor="#333333", fontname="Helvetica-Bold"];
  h1 -> lo [];
  h2 -> lo [];
  lo -> e [];
}