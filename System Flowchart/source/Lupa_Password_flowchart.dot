digraph F {
  graph [rankdir=TB, splines=spline, nodesep=0.7, ranksep=0.45, fontname="Helvetica", label="FLOWCHART LUPA DAN RESET PASSWORD", labelloc=t, labeljust=l, fontsize=16, pad=0.4, bgcolor="white"];
  node [fontname="Helvetica", fontsize=12, penwidth=1.3];
  edge [fontname="Helvetica", fontsize=11, color="#222222", arrowsize=0.8];
  s [shape=ellipse, style=filled, fillcolor="#d5e8d4", color="#82b366", width=1.6, height=0.6, label="Mulai"];
  f0 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Buka halaman Lupa Password"];
  f1 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Isi email"];
  f2 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Email terdaftar?"];
  f3 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Link reset dikirim\n(berlaku 1 jam)"];
  f4 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Buka link reset di email"];
  f5 [shape=parallelogram, style=filled, fillcolor="#fff2cc", color="#d6b656", width=2.6, height=0.6, label="Isi password baru\n& konfirmasi"];
  f6 [shape=diamond, style=filled, fillcolor="#f8cecc", color="#b85450", width=3.0, height=1.1, label="Token valid, password\n≥ 6 & cocok?"];
  f7 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Password diperbarui"];
  f8 [shape=box, style=filled, fillcolor="#dae8fc", color="#6c8ebf", width=2.6, height=0.6, label="Login dengan password baru"];
  e [shape=ellipse, style=filled, fillcolor="#d5e8d4", color="#82b366", width=1.6, height=0.6, label="Selesai"];
  s -> f0 [];
  f0 -> f1 [];
  f1 -> f2 [];
  f2 -> f1 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  f2 -> f3 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  f3 -> f4 [];
  f4 -> f5 [];
  f5 -> f6 [];
  f6 -> f5 [label="Tidak", fontcolor="#c62828", fontname="Helvetica-Bold", constraint=false, tailport=e, headport=e];
  f6 -> f7 [label="Ya", fontcolor="#1a7f37", fontname="Helvetica-Bold"];
  f7 -> f8 [];
  f8 -> e [];
}